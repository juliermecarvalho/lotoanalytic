# Variaveis consumidas por docker-compose.prod.yml. Copie para .env e preencha.

# Banco de dados
POSTGRES_PASSWORD=

# Acesso a API da Caixa
#
# O CDN da Caixa recusa (HTTP 403) as requisicoes vindas do servidor de producao. Para contornar,
# use UMA das duas opcoes abaixo.
#
# Opcao 1 - relay proprio hospedado no Brasil que repassa as chamadas:
# CAIXA_BASE_URL=https://meu-relay.com.br/portaldeloterias/api
#
# Opcao 2 - proxies publicos. Gere a lista com:
#   bash scripts/find-caixa-proxies.sh 40
# O script testa cada endereco contra a API real e imprime estas duas linhas prontas.
# Precisa ser uma lista com dezenas de enderecos: proxies gratuitos caem em minutos e a
# aplicacao alterna entre eles automaticamente.
CAIXA_PROXY_ENABLED=false
CAIXA_PROXY_ADDRESSES=

# Opcionais. Aplicam-se a todos os proxies da lista.
CAIXA_PROXY_TIMEOUT_SECONDS=15
CAIXA_PROXY_COOLDOWN_SECONDS=120
CAIXA_PROXY_USERNAME=
CAIXA_PROXY_PASSWORD=
