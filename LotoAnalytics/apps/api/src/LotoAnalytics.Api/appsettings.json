{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Keycloak": {
    "Authority": "http://localhost:8080/realms/lotoanalytics",
    "Audience": "lotoanalytics-api",
    "RequireHttpsMetadata": false,
    "UsernameClaim": "preferred_username"
  },
  "ContestUpdates": {
    "Enabled": true,
    "RunOnStartup": true,
    "DailyRunAt": "01:00:00",
    "TimeZoneId": "E. South America Standard Time",
    "DelayMilliseconds": 200,
    "ErrorDelayMilliseconds": 300000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
