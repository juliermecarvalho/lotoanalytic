{
  "realm": "lotoanalytics",
  "enabled": true,
  "loginTheme": "lotoanalytics",
  "internationalizationEnabled": true,
  "defaultLocale": "pt-BR",
  "supportedLocales": [
    "pt-BR"
  ],
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "resetPasswordAllowed": true,
  "verifyEmail": true,
  "defaultRoles": [
    "offline_access",
    "uma_authorization"
  ],
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "noreply@lotoanalytics.local",
    "fromDisplayName": "LotoAnalytics",
    "replyTo": "suporte@lotoanalytics.local",
    "replyToDisplayName": "Suporte LotoAnalytics",
    "ssl": "false",
    "starttls": "false",
    "auth": "false"
  },
  "roles": {
    "realm": [
      {
        "name": "administrador",
        "description": "Administrador do LotoAnalytics"
      }
    ]
  },
  "clients": [
    {
      "clientId": "lotoanalytics-web",
      "name": "LotoAnalytics Web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "rootUrl": "http://127.0.0.1:5174",
      "baseUrl": "/gerar-jogos/lotofacil",
      "redirectUris": [
        "http://127.0.0.1:5174/*",
        "http://localhost:5174/*"
      ],
      "webOrigins": [
        "http://127.0.0.1:5174",
        "http://localhost:5174"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "audience-lotoanalytics-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "lotoanalytics-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "lotoanalytics-api",
      "name": "LotoAnalytics API",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": true
    }
  ],
  "identityProviders": [
    {
      "alias": "google",
      "displayName": "Google",
      "providerId": "google",
      "enabled": true,
      "trustEmail": false,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "authenticateByDefault": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "${env.GOOGLE_CLIENT_ID:configure-google-client-id}",
        "clientSecret": "${env.GOOGLE_CLIENT_SECRET:configure-google-client-secret}",
        "defaultScope": "openid profile email",
        "syncMode": "IMPORT"
      }
    },
    {
      "alias": "facebook",
      "displayName": "Facebook",
      "providerId": "facebook",
      "enabled": true,
      "trustEmail": false,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "authenticateByDefault": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "${env.FACEBOOK_CLIENT_ID:configure-facebook-client-id}",
        "clientSecret": "${env.FACEBOOK_CLIENT_SECRET:configure-facebook-client-secret}",
        "defaultScope": "email,public_profile",
        "syncMode": "IMPORT"
      }
    },
    {
      "alias": "linkedin",
      "displayName": "LinkedIn",
      "providerId": "linkedin-openid-connect",
      "enabled": true,
      "trustEmail": false,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "authenticateByDefault": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "${env.LINKEDIN_CLIENT_ID:configure-linkedin-client-id}",
        "clientSecret": "${env.LINKEDIN_CLIENT_SECRET:configure-linkedin-client-secret}",
        "defaultScope": "openid profile email",
        "syncMode": "IMPORT"
      }
    },
    {
      "alias": "microsoft",
      "displayName": "Microsoft",
      "providerId": "microsoft",
      "enabled": true,
      "trustEmail": false,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "authenticateByDefault": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "${env.MICROSOFT_CLIENT_ID:configure-microsoft-client-id}",
        "clientSecret": "${env.MICROSOFT_CLIENT_SECRET:configure-microsoft-client-secret}",
        "defaultScope": "openid profile email",
        "syncMode": "IMPORT"
      }
    }
  ],
  "users": [
    {
      "username": "dev",
      "enabled": true,
      "emailVerified": true,
      "email": "dev@lotoanalytics.local",
      "firstName": "Dev",
      "lastName": "Local",
      "attributes": {
        "locale": [
          "pt-BR"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "dev123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "administrador"
      ]
    }
  ]
}
