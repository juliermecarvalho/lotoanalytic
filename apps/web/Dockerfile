FROM node:24-alpine AS build
WORKDIR /app

ARG VITE_API_BASE_URL=http://localhost:5291
ARG VITE_KEYCLOAK_AUTHORITY=http://localhost:8080/realms/lotoanalytics
ARG VITE_KEYCLOAK_CLIENT_ID=lotoanalytics-web
ARG VITE_ADSENSE_CLIENT=
ARG VITE_ADSENSE_SLOT_LEADERBOARD=
ARG VITE_ADSENSE_SLOT_RECTANGLE=
ARG VITE_ADSENSE_SLOT_HALF_PAGE=
ARG VITE_ADSENSE_SLOT_SIDEBAR_EXTRA=
ARG VITE_ADSENSE_SLOT_RESPONSIVE=

ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_KEYCLOAK_AUTHORITY=$VITE_KEYCLOAK_AUTHORITY
ENV VITE_KEYCLOAK_CLIENT_ID=$VITE_KEYCLOAK_CLIENT_ID
ENV VITE_ADSENSE_CLIENT=$VITE_ADSENSE_CLIENT
ENV VITE_ADSENSE_SLOT_LEADERBOARD=$VITE_ADSENSE_SLOT_LEADERBOARD
ENV VITE_ADSENSE_SLOT_RECTANGLE=$VITE_ADSENSE_SLOT_RECTANGLE
ENV VITE_ADSENSE_SLOT_HALF_PAGE=$VITE_ADSENSE_SLOT_HALF_PAGE
ENV VITE_ADSENSE_SLOT_SIDEBAR_EXTRA=$VITE_ADSENSE_SLOT_SIDEBAR_EXTRA
ENV VITE_ADSENSE_SLOT_RESPONSIVE=$VITE_ADSENSE_SLOT_RESPONSIVE

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
